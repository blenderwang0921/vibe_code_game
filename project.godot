; Open with Godot 4 standard edition. All gameplay is offline.
config_version=5

[application]
config/name="暮光林地｜小巫師的第一課"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/dpi/allow_hidpi=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=1024
environment/defaults/default_clear_color=Color(0.055, 0.085, 0.12, 1)

[physics]
common/physics_ticks_per_second=60

[layer_names]
3d_physics/layer_1="Ground"
3d_physics/layer_2="Obstacles"
3d_physics/layer_3="Player"
3d_physics/layer_4="Enemies"

